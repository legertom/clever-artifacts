{
  "name": "clever-artifacts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --env-file-if-exists=.env.local scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@neondatabase/serverless": "^1.2.0",
    "@sparticuz/chromium": "^153.0.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "mcp-handler": "^2.3.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "puppeteer-core": "25.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
