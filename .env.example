# --- Auth.js ---------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI: <your-origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only needed when not on Vercel (e.g. local dev behind a non-localhost host).
# AUTH_URL=http://localhost:3000

# --- Access policy ---------------------------------------------------------
# Only Google accounts on this domain may sign in, and only emails on this
# domain can be added to an artifact's share list.
ALLOWED_EMAIL_DOMAIN=clever.com

# --- Database (Neon) -------------------------------------------------------
# Neon dashboard → Connect → connection string (pooled is fine).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Screenshots -----------------------------------------------------------
# On Vercel the bundled serverless Chromium is used automatically.
# Locally, Chrome is auto-detected on macOS/Linux; override if needed:
# CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
